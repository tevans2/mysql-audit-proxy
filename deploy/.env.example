# Secrets for the local compose stack. `make up` copies this to deploy/.env
# (gitignored) on a clean checkout; edit that copy, never this file.
#
# These are the well-known development values the tests, CI and Makefile
# targets default to. Anything beyond a laptop needs its own — see "Secrets"
# in deploy/README.md for how to generate each one.
#
# Single quotes keep a value literal: Compose expands $ inside unquoted and
# double-quoted values, which would mangle the bcrypt hash.

# Upstream MySQL root and application-user passwords. The root passwords also
# feed the proxy's PROXY_UPSTREAM_PASSWORDS, so they are set only here.
DB_A_ROOT_PASSWORD='rootpass'
DB_A_APP_PASSWORD='demopass'
DB_B_ROOT_PASSWORD='rootpass-b'
DB_B_APP_PASSWORD='hrpw'

# Per-user MySQL accounts (ADR 0004), created by deploy/initdb/*/03-users.sh.
# alice (db-a) and bob (db-b) are real database users with narrow grants; the
# bootstrap account on each has GRANT USAGE only. No ' or \ in these: they are
# placed inside a SQL string. Like every initdb script, this only runs on a
# fresh data directory — changing one here needs `down -v` to take effect.
DB_A_ALICE_PASSWORD='alice-db-pw'
DB_A_BOOTSTRAP_PASSWORD='bootstrap-a-pw'
DB_B_BOB_PASSWORD='bob-db-pw'
DB_B_BOOTSTRAP_PASSWORD='bootstrap-b-pw'

# bcrypt hash of the back-office admin password.
API_ADMIN_PASS_HASH='$2a$10$p/JfpdaXDpAp5XhXeDax6OdUOClgnJGA8zH3X7Gxrf0dv5zvjb/UW'

# AES-256 key for upstream passwords stored in the API database. Exactly 32
# characters. Changing it makes passwords already in the api-data volume
# undecryptable — wipe the volume (`down -v`) or re-enter them.
API_CONFIG_KEY='0123456789abcdef0123456789abcdef'

# Service token the proxy presents to GET /api/proxy/config.
API_PROXY_TOKEN='local-dev-proxy-token'

# Address the edge serves the back-office UI on. 'localhost' gives
# https://localhost with a locally-issued certificate (the browser warns once).
# A real domain gets a certificate fetched and renewed automatically, and needs
# public DNS plus ports 80 and 443 reachable.
SITE_ADDRESS='localhost'
